# Copy to .env on the Pi: cp .env.example .env && chmod 600 .env   (.env is git-ignored; never commit it)

# Pin an exact release; check https://github.com/bluenviron/mediamtx/releases before bumping.
MEDIAMTX_VERSION=1.21.2

# Password the ZowieBox uses to publish to the relay (user: zowie).
# Use only letters and digits, since it travels in a URL: openssl rand -hex 16
ZOWIEBOX_PUBLISH_PASSWORD=change-me-0123456789abcdef

# YouTube: custom (reusable) stream key, with Auto-start / Auto-stop enabled.
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Facebook: Live Producer > Advanced settings > Persistent stream key.
FACEBOOK_STREAM_KEY=FB-000000000000000-0-AbCdEfGhIjKlMnOp

# Telegram: channel > Live Stream > Stream with...
# Server URL exactly as shown, but WITHOUT the trailing slash; the dc number varies per account.
TELEGRAM_SERVER_URL=rtmps://dc4-1.rtmp.t.me/s
TELEGRAM_STREAM_KEY=0000000000:AbCdEfGhIjKlMnOpQrStUv

# Archive upload (rclone). Pin an exact release: https://github.com/rclone/rclone/releases
RCLONE_VERSION=1.75.2
# <remote name from rclone config>:<folder>
RCLONE_DESTINATION=archive:stream-audio
